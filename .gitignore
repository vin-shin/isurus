# --- Build output -----------------------------------------------------------
build/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Ninja
.ninja_deps
.ninja_log

# Compiler / linker artifacts
*.o
*.d
*.a
*.elf
*.map
*.bin
*.hex
*.list

# --- STM32CubeMX ------------------------------------------------------------
# Internal CubeMX state; regenerated from the .ioc. The .ioc itself IS tracked.
.mxproject
*.ioc.bak

# --- Stray personal media --------------------------------------------------
# Photos/videos/PDFs have ended up in .vscode/ before; keep them out of the repo.
.vscode/*.gif
.vscode/*.mov
.vscode/*.mp4
.vscode/*.png
.vscode/*.jpg
.vscode/*.pdf

# --- Editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# Bench capture data from tools/step_trace.sh - regenerate, do not commit.
step_trace_raw.txt

# Generated figure sets from tools/viz.py report. Regenerate rather than
# commit: every run restamps the plotted-at time, so these churn as binaries.
reports/

# Python bytecode from tools/
__pycache__/
*.pyc

# Datasheets and the board schematic.
#
# Kept OUT of the repository deliberately. This remote is public, and
# docs/powerunit.pdf is Gaucho Racing's own schematic - engineer named on
# every sheet. The vendor datasheets are third-party documents and 6.9 MB
# that would land in every clone forever.
#
# Nothing is lost by excluding them: every number taken from them is written
# into board.h, limits.h, docs/LATER.md and docs/HARDWARE-CHANGES.md with its
# provenance, which is more useful than the PDF anyway. Drop the files into
# docs/ locally if you want to check the working against the source.
docs/*.pdf
